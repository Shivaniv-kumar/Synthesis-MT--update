{
  "name": "meeting-action-tracker-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prestart": "sh -c 'test -f dist/index.html || npx vite build; test -f dist/index.html'",
    "start": "npx --yes serve@14.2.6 -s dist -l tcp://0.0.0.0:${PORT:-8080}",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "axios": "^1.6.8",
    "@tanstack/react-query": "^5.51.21",
    "zustand": "^4.5.4",
    "react-hook-form": "^7.52.2",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  }
}
