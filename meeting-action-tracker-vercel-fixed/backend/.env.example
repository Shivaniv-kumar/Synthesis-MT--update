# =============================================================================
# Meeting Action Tracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before starting the service.
# Lines beginning with # are comments and are ignored by the application.
# =============================================================================


# =============================================================================
# CORE — Database & Server
# =============================================================================

# PostgreSQL async connection string (asyncpg driver required).
# For Supabase production deployments, do not use the transaction pooler
# on port 6543 with this SQLAlchemy asyncpg app. Use either:
#   1. Session pooler: postgres://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
#   2. Direct connection: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/meeting_tracker

# Optional direct Supabase connection. When set, the app and Alembic prefer
# this over DATABASE_URL. Useful for migrations and long-running backends when
# the deployment host can reach Supabase's direct endpoint.
DIRECT_DATABASE_URL=

# Deployment environment: development | staging | production
ENVIRONMENT=development

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# URL of the frontend SPA — used to build CORS allowed-origins list.
# In production this must be a browser origin with scheme, for example:
# https://frontend-production-1234.up.railway.app
FRONTEND_URL=http://localhost:5173


# =============================================================================
# AUTH — JWT + SSO
# =============================================================================

# Secret used to sign JWT access tokens — MUST be changed in production
SECRET_KEY=change-me-in-production

# Enable local email/password authentication in a production deployment.
# Keep this false when enterprise SSO is configured.
ALLOW_PASSWORD_LOGIN=false

# Optional one-time bootstrap administrator. When enabled, the account is
# created or refreshed at backend startup. Use a strong temporary password,
# sign in, create the permanent administrators, then set SEED_ADMIN=false.
SEED_ADMIN=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Test Administrator

# Which SSO provider to use: workos | auth0
SSO_PROVIDER=workos

# WorkOS credentials (required when SSO_PROVIDER=workos)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Auth0 credentials (required when SSO_PROVIDER=auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=


# =============================================================================
# LLM — Anthropic Claude
# =============================================================================

# Anthropic API key used for action-item extraction
ANTHROPIC_API_KEY=

# Which Claude model to use for each tier
EXTRACTION_MODEL=claude-sonnet-4-6
HAIKU_MODEL=claude-haiku-4-5
OPUS_MODEL=claude-opus-4-8

# OpenAI API key (used by the Whisper transcription provider)
OPENAI_API_KEY=


# =============================================================================
# TRANSCRIPTION — Audio-to-text backend
# =============================================================================

# Transcription provider: whisper | deepgram | assemblyai
TRANSCRIPTION_PROVIDER=whisper

# Deepgram API key (required when TRANSCRIPTION_PROVIDER=deepgram)
DEEPGRAM_API_KEY=

# AssemblyAI API key (required when TRANSCRIPTION_PROVIDER=assemblyai)
ASSEMBLYAI_API_KEY=


# =============================================================================
# STORAGE — S3-compatible object storage
# =============================================================================

# S3 bucket name for audio uploads and transcript storage
S3_BUCKET=meeting-tracker-audio

# Custom S3-compatible endpoint URL (leave empty to use AWS S3)
S3_ENDPOINT_URL=

# S3 access credentials
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Maximum allowed upload size in megabytes
MAX_UPLOAD_SIZE_MB=500


# =============================================================================
# EMAIL — Outbound notifications
# =============================================================================

# From address shown on all outbound notification emails
EMAIL_FROM=noreply@meetingtracker.app

# SendGrid API key — if set, SendGrid is used instead of SMTP
SENDGRID_API_KEY=

# SMTP settings (used when SENDGRID_API_KEY is empty)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=


# =============================================================================
# REDIS / CELERY — Task queue and caching
# =============================================================================

# Redis URL used as Celery broker, result backend, and rate-limit store
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# OBSERVABILITY — OpenTelemetry tracing & metrics
# =============================================================================

# OTLP collector gRPC endpoint for traces and metrics (Jaeger, Grafana, etc.)
OTLP_ENDPOINT=http://localhost:4317


# =============================================================================
# BI — Business Intelligence feed
# =============================================================================

# Shared API key used to authenticate BI dashboard consumers
BI_API_KEY=

# Tenant identifier passed to the BI system for data partitioning
BI_TENANT_ID=
